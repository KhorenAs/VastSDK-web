{
  "name": "vastsdk-web",
  "private": true,
  "description": "Native VAST 4.3 linear-video ad SDK for the web. No Google IMA, no VPAID, no iframes.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/vast-core",
    "packages/vast-kit",
    "packages/vast-videojs",
    "demo"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "demo": "npm run dev --workspace demo",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
